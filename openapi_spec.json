{
  "openapi": "3.1.0",
  "info": {
    "title": "Fe Urea Calculator API",
    "description": "FEUrea calculation and legacy demonstration audit endpoints",
    "version": "3.0.1",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON counters for in-process audit requests",
        "responses": {
          "200": {
            "description": "JSON statistics; not Prometheus text"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Return a deterministic mock response (not clinical verification)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/fe-urea": {
      "post": {
        "summary": "Calculate fractional excretion of urea with numeric validation",
        "description": "Within each serum/urine analyte pair, units and analyte definitions must match. The 35% cutoff is not diagnostic.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "serum_creatinine": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "urine_creatinine": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "serum_urea": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "urine_urea": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "serum_creatinine",
                  "urine_creatinine",
                  "serum_urea",
                  "urine_urea"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "FEUrea percentage and non-diagnostic interpretation"
          },
          "422": {
            "description": "Invalid measurements"
          }
        }
      }
    }
  }
}
